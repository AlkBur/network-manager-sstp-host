+    widget = GTK_WIDGET (gtk_builder_get_object (priv->builder, "host_entry"));
+    if (widget) {
+        str = gtk_editable_get_text (GTK_EDITABLE (widget));
+        if (str && strlen (str)) {
+            const char *p;
+            size_t len = strlen (str);
+            char **labels;
+            int i, nlabels;
+            gboolean invalid = FALSE;
+
+            if (len > 253 || str[len - 1] == '.')
+                invalid = TRUE;
+            for (p = str; *p && !invalid; p++) {
+                if (!(g_ascii_isalnum (*p) || *p == '.' || *p == '-'))
+                    invalid = TRUE;
+            }
+            if (!invalid) {
+                labels = g_strsplit (str, ".", -1);
+                nlabels = g_strv_length (labels);
+                for (i = 0; i < nlabels; i++) {
+                    size_t llen = strlen (labels[i]);
+                    if (llen == 0 || llen > 63 ||
+                        labels[i][0] == '-' || labels[i][llen - 1] == '-') {
+                        invalid = TRUE;
+                        break;
+                    }
+                }
+                g_strfreev (labels);
+            }
+            if (invalid) {
+                gtk_style_context_add_class (gtk_widget_get_style_context (widget), "error");
+                g_set_error (error,
+                             NMV_EDITOR_PLUGIN_ERROR,
+                             NMV_EDITOR_PLUGIN_ERROR_INVALID_PROPERTY,
+                             _("Invalid hostname."));
+                return FALSE;
+            }
+        }
+        gtk_style_context_remove_class (gtk_widget_get_style_context (widget), "error");
+    }
+
